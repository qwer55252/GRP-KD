{
  "name": "GRP-KD",
  "image": "nvcr.io/nvidia/nemo:25.02",
  "workspaceFolder": "/workspace/GRP-KD",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/GRP-KD,type=bind",
  "runArgs": ["--gpus", "all", "--shm-size", "16g", "--ipc", "host"],
  "customizations": {"vscode": {"extensions": ["ms-python.python"]}}
}
